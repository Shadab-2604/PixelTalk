# ============================================================
# PIXELTALK FRONTEND ENVIRONMENT VARIABLES (.env.example)
# ============================================================

# Backend HTTP API URL (include /api suffix, no trailing slash)
# Production (Render): https://pixeltalk-backend-1.onrender.com/api
# Local development: http://localhost:5000/api
NEXT_PUBLIC_API_URL=https://pixeltalk-backend-1.onrender.com/api

# Real-time WebSocket / Socket.IO Server Endpoint (no trailing slash)
# Production: https://pixeltalk-backend-1.onrender.com
# Local development: http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=https://pixeltalk-backend-1.onrender.com

# Canonical Public App URL (used for SEO, metadataBase, robots.txt, and sitemap.xml)
# Production: https://pixel-talk-qofh.vercel.app
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://pixel-talk-qofh.vercel.app

# --- Optional: WebRTC 1-on-1 Voice/Video Calling Configuration ---
# Public STUN Server for NAT traversal
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302
