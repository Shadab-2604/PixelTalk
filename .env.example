# ============================================================
# PIXELTALK FRONTEND ENVIRONMENT VARIABLES (.env.example)
# ============================================================

# Backend HTTP API URL (include /api suffix, no trailing slash)
# Production (Vercel/Railway/Render): https://pixel-talk-backend.vercel.app/api
# Local development: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Real-time WebSocket / Socket.IO Server Endpoint (no trailing slash)
# Production: https://pixel-talk-backend.vercel.app (or Railway/Render persistent backend URL)
# Local development: http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Canonical Public App URL (used for SEO, metadataBase, robots.txt, and sitemap.xml)
# Production: https://pixel-talk-cyan.vercel.app
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: WebRTC 1-on-1 Voice/Video Calling Configuration ---
# Public STUN Server for NAT traversal
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN Server for symmetric NATs / strict firewalls
# NEXT_PUBLIC_TURN_SERVER_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your_turn_username
# NEXT_PUBLIC_TURN_CREDENTIAL=your_turn_password
